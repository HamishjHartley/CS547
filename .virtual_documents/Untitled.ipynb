import numpy as np
import random
from deap import base, creator, tools, algorithms
import matplotlib.pyplot as plt

# Step 1: Load Data
def parse_fault_matrix(file_path):
    with open(file_path, 'r') as file:
        fault_matrix = []
        for line in file:
            parts = line.strip().split(',')
            test_id = parts[0]
            faults = list(map(int, parts[1:]))
            fault_matrix.append((test_id, faults))
    return fault_matrix

# Load both datasets
small_data = load_data(r"smallfaultmatrixplustime.txt")


# Step 2: Fitness Functions
def fault_coverage(selected_tests):
    faults_covered = set()
    for faults, _ in selected_tests:
        faults_covered.update(idx for idx, fault in enumerate(faults) if fault == 1)
    return len(faults_covered)

def total_execution_time(selected_tests):
    return sum(time for _, time in selected_tests)

def test_set_size(selected_tests):
    return len(selected_tests)

# Step 3: Genetic Algorithm Representation and Initialization
creator.create("FitnessMulti", base.Fitness, weights=(1.0, -1.0, -1.0))  # Max coverage, Min time, Min size
creator.create("Individual", list, fitness=creator.FitnessMulti)

def create_individual(data):
    return creator.Individual([random.choice([0, 1]) for _ in range(len(data))])

toolbox = base.Toolbox()
toolbox.register("individual", create_individual, data=small_data)
toolbox.register("population", tools.initRepeat, list, toolbox.individual)

# Step 4: Multi-Objective Fitness Evaluation
def evaluate(individual, data):
    selected_tests = [data[i] for i, selected in enumerate(individual) if selected == 1]
    coverage = fault_coverage(selected_tests)
    execution_time = total_execution_time(selected_tests)
    size = test_set_size(selected_tests)
    return (coverage, execution_time, size)

toolbox.register("evaluate", evaluate, data=small_data)
toolbox.register("mate", tools.cxUniform, indpb=0.5)
toolbox.register("mutate", tools.mutFlipBit, indpb=0.05)
toolbox.register("select", tools.selNSGA2)

# Step 5: Run Genetic Algorithm
population = toolbox.population(n=100)
num_generations = 50

for gen in range(num_generations):
    offspring = toolbox.select(population, len(population))
    offspring = list(map(toolbox.clone, offspring))

    for child1, child2 in zip(offspring[::2], offspring[1::2]):
        if random.random() < 0.7:
            toolbox.mate(child1, child2)
        toolbox.mutate(child1)
        toolbox.mutate(child2)

    invalid_individuals = [ind for ind in offspring if not ind.fitness.valid]
    fitnesses = map(toolbox.evaluate, invalid_individuals)
    for ind, fit in zip(invalid_individuals, fitnesses):
        ind.fitness.values = fit

    population[:] = offspring

# Step 6: Evaluate Final Population and Plot
final_fitness = [ind.fitness.values for ind in population]

# Plot the Pareto front for Execution Time vs Fault Coverage
coverages = [f[0] for f in final_fitness]
times = [f[1] for f in final_fitness]
sizes = [f[2] for f in final_fitness]

plt.figure(figsize=(10, 6))
plt.scatter(times, coverages, c=sizes, cmap='viridis')
plt.colorbar(label='Test Set Size')
plt.xlabel("Total Execution Time")
plt.ylabel("Fault Coverage")
plt.title("Pareto Front for Fault Coverage vs Execution Time (Test Set Size as Color)")
plt.show()



